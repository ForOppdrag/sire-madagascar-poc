# Copier ce fichier en .env et changer les mots de passe avant le premier démarrage.
POSTGRES_DB=sire
POSTGRES_USER=sire
POSTGRES_PASSWORD=changer-ce-mot-de-passe
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=changer-ce-mot-de-passe-aussi
PUBLIC_URL=http://localhost:8000

# Images (à ajuster si une étiquette n'est plus disponible)
POSTGIS_IMAGE=postgis/postgis:16-3.4
GEOSERVER_IMAGE=kartoza/geoserver:2.25.2
PYGEOAPI_IMAGE=geopython/pygeoapi:latest
GDAL_IMAGE=ghcr.io/osgeo/gdal:ubuntu-small-3.9.2
